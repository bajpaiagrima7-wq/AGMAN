<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="AgrimaBajpai.AGMAN"
      Name="AGMAN"
      Manufacturer="Agrima Bajpai"
      Version="1.0.0"
      Scope="perMachine">

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AGMAN">
        <File
            Id="AGMANExe"
            Source="!(bindpath.AGMANBuild)\AGMAN.exe"
            KeyPath="yes">

          <Shortcut
              Id="AGMANStartMenuShortcut"
              Directory="ProgramMenuFolder"
              Name="AGMAN"
              Description="Launch AGMAN"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="yes" />

          <Shortcut
              Id="AGMANDesktopShortcut"
              Directory="DesktopFolder"
              Name="AGMAN"
              Description="Launch AGMAN"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="yes" />

        </File>
      </Directory>
    </StandardDirectory>

    <Files
        Include="!(bindpath.AGMANBuild)\_internal\**"
        Directory="INSTALLFOLDER"
        Subdirectory="_internal" />

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

  </Package>
</Wix>
