<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <OutputName>AGMANSetup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(MSBuildProjectDirectory)\..\dist\AGMAN">
      <BindName>AGMANBuild</BindName>
    </BindPath>
  </ItemGroup>
</Project>
